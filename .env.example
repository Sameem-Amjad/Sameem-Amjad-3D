# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` (local) and set the values below.
# On your host (Vercel/Netlify/etc.) add the SAME three vars in the
# project's Environment Variables settings — they are read at BUILD time.
#
# These power the Contact form via EmailJS (emailjs.com).
# NOTE: Vite inlines any VITE_-prefixed var into the client bundle, so these
# ship to the browser. That's expected for EmailJS (the public key is meant to
# be public) — lock down abuse in the EmailJS dashboard (allowed domains +
# reCAPTCHA), NOT by hiding these values.
# ─────────────────────────────────────────────────────────────

# EmailJS → Email Services → your service → Service ID
VITE_APP_EMAILJS_SERVICE_ID=service_xxxxxxx

# EmailJS → Email Templates → your template → Template ID
# The template must reference these variables (the app sends them):
#   {{from_name}} {{from_email}} {{to_name}} {{to_email}} {{message}}
VITE_APP_EMAILJS_TEMPLATE_ID=template_xxxxxxx

# EmailJS → Account → General / API Keys → Public Key
VITE_APP_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx
